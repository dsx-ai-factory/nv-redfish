<!-- nv-redfish additions; keep the upstream schemas unchanged. -->
<edmx:Edmx xmlns="http://docs.oasis-open.org/odata/ns/edm" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData" />
  </edmx:Reference>
  <edmx:Reference Uri="NvidiaComputerSystem_v1.xml">
    <edmx:Include Namespace="NvidiaComputerSystem.v1_6_0" />
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="NvidiaComputerSystem.NvRedfish">
      <ComplexType Name="NvidiaComputerSystem" BaseType="NvidiaComputerSystem.v1_6_0.NvidiaComputerSystem">
        <Property Name="BaseMAC" Type="Edm.String">
          <Annotation Term="OData.Description" String="Base MAC address of the BlueField device." />
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read" />
        </Property>
        <Property Name="Mode" Type="NvidiaComputerSystem.NvRedfish.Mode">
          <Annotation Term="OData.Description" String="Current BlueField operating mode." />
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read" />
        </Property>
        <Property Name="HostRshim" Type="NvidiaComputerSystem.NvRedfish.HostRshim">
          <Annotation Term="OData.Description" String="Current host-side rshim interface state." />
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read" />
        </Property>
        <Property Name="Actions" Type="NvidiaComputerSystem.NvRedfish.Actions" Nullable="false">
          <Annotation Term="OData.Description" String="Actions advertised by the BlueField OEM resource." />
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read" />
        </Property>
      </ComplexType>
      <EnumType Name="Mode">
        <Annotation Term="OData.Description" String="Operating mode of a BlueField device." />
        <Member Name="NicMode">
          <Annotation Term="OData.Description" String="The device operates as a regular NIC for the host." />
        </Member>
        <Member Name="DpuMode">
          <Annotation Term="OData.Description" String="The device controls packet processing as a DPU." />
        </Member>
      </EnumType>
      <EnumType Name="HostRshim">
        <Annotation Term="OData.Description" String="State of the host-side rshim interface of a BlueField device." />
        <Member Name="Enabled">
          <Annotation Term="OData.Description" String="The host can reach the DPU over rshim." />
        </Member>
        <Member Name="Disabled">
          <Annotation Term="OData.Description" String="The host cannot reach the DPU over rshim." />
        </Member>
      </EnumType>
      <ComplexType Name="Actions">
        <Annotation Term="OData.AdditionalProperties" Bool="false" />
      </ComplexType>
    </Schema>
    <Schema Namespace="Mode">
      <Action Name="Set" IsBound="true">
        <Annotation Term="OData.Description" String="Set the BlueField operating mode." />
        <Parameter Name="ComputerSystem" Type="NvidiaComputerSystem.NvRedfish.Actions" />
        <Parameter Name="Mode" Type="NvidiaComputerSystem.NvRedfish.Mode" Nullable="false" />
      </Action>
    </Schema>
    <Schema Namespace="HostRshim">
      <Action Name="Set" IsBound="true">
        <Annotation Term="OData.Description" String="Enable or disable the host-side rshim interface." />
        <Parameter Name="ComputerSystem" Type="NvidiaComputerSystem.NvRedfish.Actions" />
        <Parameter Name="HostRshim" Type="NvidiaComputerSystem.NvRedfish.HostRshim" Nullable="false" />
      </Action>
    </Schema>
    <Schema Namespace="SOC">
      <Action Name="ForceReset" IsBound="true">
        <Annotation Term="OData.Description" String="Force a reset of the DPU Arm SoC." />
        <Parameter Name="ComputerSystem" Type="NvidiaComputerSystem.NvRedfish.Actions" />
      </Action>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
