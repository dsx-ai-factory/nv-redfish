<!-- nv-redfish additions; keep the upstream schemas unchanged. -->
<edmx:Edmx xmlns="http://docs.oasis-open.org/odata/ns/edm" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData" />
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/UpdateService_v1.xml">
    <edmx:Include Namespace="UpdateService.v1_0_0" />
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/SoftwareInventory_v1.xml">
    <edmx:Include Namespace="SoftwareInventory" />
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="NvidiaUpdateService.NvRedfish">
      <Action Name="ClearNVRAM" IsBound="true">
        <Annotation Term="OData.Description" String="This action clears NVRAM for the selected firmware inventory targets." />
        <Annotation Term="OData.LongDescription" String="This action shall clear NVRAM for the selected firmware inventory targets." />
        <Parameter Name="NvidiaUpdateService" Type="UpdateService.v1_0_0.OemActions" />
        <Parameter Name="Targets" Type="Collection(SoftwareInventory.SoftwareInventory)" Nullable="false">
          <Annotation Term="OData.Description" String="An array of firmware inventory resources whose NVRAM is cleared." />
          <Annotation Term="OData.LongDescription" String="This parameter shall contain firmware inventory resources whose NVRAM is cleared." />
          <Annotation Term="OData.IsURL" />
        </Parameter>
      </Action>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
