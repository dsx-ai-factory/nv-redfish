<!-- nv-redfish additions; keep the upstream schemas unchanged. -->
<edmx:Edmx xmlns="http://docs.oasis-open.org/odata/ns/edm" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData" />
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
    <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish" />
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Chassis_v1.xml">
    <edmx:Include Namespace="Chassis.v1_0_0" />
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="NvidiaChassis.NvRedfish">
      <Action Name="Reset" IsBound="true">
        <Annotation Term="OData.Description" String="This action performs a chassis or Data Processing Unit (DPU) reset as specified by the ResetType parameter." />
        <Annotation Term="OData.LongDescription" String="This action shall perform the reset type specified by the ResetType parameter for this chassis." />
        <Parameter Name="Chassis" Type="Chassis.v1_0_0.OemActions" />
        <Parameter Name="ResetType" Type="NvidiaChassis.NvRedfish.NvidiaChassisResetType" Nullable="false">
          <Annotation Term="OData.Description" String="The type of chassis or DPU reset." />
          <Annotation Term="OData.LongDescription" String="This parameter shall contain the type of chassis or DPU reset to perform." />
        </Parameter>
        <Annotation Term="Redfish.Revisions">
          <Collection>
            <Record>
              <PropertyValue Property="Kind" EnumMember="Redfish.RevisionKind/Added" />
              <PropertyValue Property="Version" String="v1_14_0" />
            </Record>
          </Collection>
        </Annotation>
      </Action>
      <EnumType Name="NvidiaChassisResetType">
        <Member Name="FullReset">
          <Annotation Term="OData.Description" String="Card Level Orchestrated Reset.  This takes effect after the next PCIe reset." />
        </Member>
        <Member Name="ForceDpuReset">
          <Annotation Term="OData.Description" String="DPU Level Immediate Reset" />
        </Member>
        <Member Name="ForcedDpuReset">
          <Annotation Term="OData.Description" String="DPU Level Immediate Reset" />
        </Member>
        <Member Name="DirectForcedDpuReset">
          <Annotation Term="OData.Description" String="DPU Level Direct Forced Reset" />
        </Member>
        <Member Name="ForcedFullReset">
          <Annotation Term="OData.Description" String="Card Level Immediate Reset" />
        </Member>
        <Member Name="DpuReset">
          <Annotation Term="OData.Description" String="DPU Level Orchestrated Reset" />
        </Member>
        <Member Name="ArmReset">
          <Annotation Term="OData.Description" String="ARM Only Reset" />
        </Member>
        <Member Name="ArmShutdown">
          <Annotation Term="OData.Description" String="ARM Shutdown" />
        </Member>
      </EnumType>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
